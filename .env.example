# Copy to .env on the server and fill in:  cp .env.example .env  &&  chmod 600 .env
#
# .env is gitignored. The values below are the ones the public demo actually
# uses, so they are safe to have here -- they are printed in every README. If
# this deployment ever holds anything private, change them and take them out of
# the READMEs in the same commit.

# ---- Caddy / TLS ----------------------------------------------------------

# The apps come up at study.<DOMAIN>, analyzer.<DOMAIN>, prepper.<DOMAIN>,
# repertoire.<DOMAIN>, weakness.<DOMAIN>.
#
# This must be a name Let's Encrypt will issue for. A DuckDNS name works
# because duckdns.org is on the Public Suffix List, so each account's name gets
# its own certificate rate limit. An sslip.io / nip.io name does NOT work --
# those are not on the list, so every user of them shares one bucket of 50
# certificates a week, and issuance fails. See NEWHOST.md.
DOMAIN=lichess-essentials.duckdns.org

# Let's Encrypt uses this only to warn about expiring certificates.
ACME_EMAIL=aayush.kumar@bermudescitadel.com

# ---- Password gates -------------------------------------------------------
#
# Each app's gate turns on only when BOTH its user and pass are non-empty
# (see e.g. player_prepper/server.py). Leave a pair blank and that app is open
# to anyone who finds the URL.
#
# One shared credential pair per app, not per-user accounts. There are no user
# accounts anywhere in these apps, and the saved data is shared too.
# Lichess-Study-to-PDF has no gate implemented, so there is nothing to set.

ANALYZER_AUTH_USER=test
ANALYZER_AUTH_PASS=testpassword1234@

PREPPER_AUTH_USER=test
PREPPER_AUTH_PASS=testpassword1234@

REPERTOIRE_AUTH_USER=test
REPERTOIRE_AUTH_PASS=testpassword1234@

WEAKNESS_AUTH_USER=test
WEAKNESS_AUTH_PASS=testpassword1234@

# ---- Deliberately absent --------------------------------------------------
#
# LICHESS_TOKEN is not here and must not be added. On a shared deployment it
# becomes a token shared by every visitor. Worse, four of the apps hold a
# token pasted into the UI in a PROCESS-WIDE global, so even pasting one by
# hand shares it with everyone until that container restarts -- and Repertoire
# Creator can publish studies to Lichess with it.
#
# REPERTOIRE_GIT_REMOTE_URL is not here either. It works around hosts with no
# persistent disk; the compose file gives Repertoire Creator a real volume, so
# it is redundant. entrypoint.sh prints an "ephemeral storage" warning at boot
# because of this -- that warning is about container disk, and the repertoires
# are on a volume.
