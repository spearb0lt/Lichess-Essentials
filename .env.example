# Copy to .env on the server and fill in:  cp .env.example .env
#
# .env is gitignored. Never commit the filled-in copy -- it holds the
# passwords that stand between the open internet and your apps.

# ---- Caddy / TLS ----------------------------------------------------------

# Your domain. The apps come up at study.<DOMAIN>, analyzer.<DOMAIN>,
# prepper.<DOMAIN>, repertoire.<DOMAIN>, weakness.<DOMAIN>.
DOMAIN=example.com

# Let's Encrypt uses this only to warn you about expiring certificates.
ACME_EMAIL=you@example.com

# ---- Password gates -------------------------------------------------------
#
# Each app's gate turns on only when BOTH its user and pass are non-empty
# (see e.g. player_prepper/server.py). Leave a pair blank and that app is
# open to anyone who finds the URL -- which, on a public IP with a domain
# pointed at it, is a real thing that happens.
#
# One shared credential pair per app, not per-user accounts. Lichess-Study-to-PDF
# has no gate implemented at all, so there is nothing to set for it.

ANALYZER_AUTH_USER=
ANALYZER_AUTH_PASS=

PREPPER_AUTH_USER=
PREPPER_AUTH_PASS=

REPERTOIRE_AUTH_USER=
REPERTOIRE_AUTH_PASS=

WEAKNESS_AUTH_USER=
WEAKNESS_AUTH_PASS=

# ---- Deliberately absent --------------------------------------------------
#
# LICHESS_TOKEN is not here and should not be added. Set on a hosted
# deployment it becomes a token shared by every visitor, and anyone with the
# URL could read whatever private studies it can see. Paste a token into the
# UI per session instead -- that keeps it to your browser, for that session.
#
# REPERTOIRE_GIT_REMOTE_URL is not here either. It exists to work around
# hosts with no persistent disk; this compose file gives Repertoire-Creator a
# real volume, so it is redundant. entrypoint.sh will print an "ephemeral
# storage" warning on boot -- that is about container disk, and your
# repertoires are not on container disk.
